# Copy to .env for local development. Never commit .env.
PORT=8787
ALLOWED_ORIGINS=

# Server-side AI provider credentials
GEMINI_API_KEY=your-gemini-api-key
# Optional preferred model; if unavailable, the server tries models advertised by Gemini.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Summary pipeline. `mock` is the only mode that returns mock content.
LLM_PROVIDER=gemini
LLM_MODEL=gemma-4-26b-a4b-it
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=4096
LLM_USE_NATIVE_SCHEMA=true
LLM_MAX_CONCURRENCY=4

# Supabase project URL and publishable key; both are read by the server.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
AUTH_SITE_URL=http://localhost:8787

# Server-only Google Cloud key for YouTube Data API v3 playlist/video metadata.
# Never expose this as a NEXT_PUBLIC_*, VITE_*, or other browser variable.
YOUTUBE_API_KEY=your-youtube-api-key
