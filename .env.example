# Copy to .env for local development. Never commit .env.
PORT=8787
ALLOWED_ORIGINS=

# Server-side AI provider credentials
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=

# Supabase project URL and publishable key; both are read by the server.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
AUTH_SITE_URL=http://localhost:8787

# Optional server-side playlist metadata
YOUTUBE_API_KEY=your-youtube-api-key
