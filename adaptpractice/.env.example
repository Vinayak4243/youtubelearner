# Copy this file to ".env" and fill in the values you need. Never commit ".env".
# Uses Anthropic when an API key is set; otherwise falls back to local Ollama.
ANTHROPIC_API_KEY=
USE_OLLAMA=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Set USE_OLLAMA=true to prefer Ollama even when an Anthropic key is configured.
CLAUDE_MODEL=claude-sonnet-5

# Comma-separated list of origins allowed to call this API.
# Leave empty for local development. Set to your real domain before deploying,
# e.g. https://www.yoursite.com
ALLOWED_ORIGINS=

PORT=8787
